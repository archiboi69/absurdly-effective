{
  "name": "absurd-effect",
  "version": "0.5.0",
  "description": "Effect-native tasks and workflows backed by Absurd",
  "keywords": [
    "absurd",
    "durable",
    "effect",
    "postgresql",
    "queue",
    "task",
    "workflow"
  ],
  "license": "Apache-2.0",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earendil-works/absurd.git",
    "directory": "sdks/effect"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./unstable/workflow": {
      "types": "./dist/unstable/workflow/index.d.ts",
      "import": "./dist/unstable/workflow/index.js",
      "require": "./dist/cjs/unstable/workflow/index.js"
    }
  },
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc --project tsconfig.build.json && tsc --project tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "type-check": "tsc --noEmit",
    "prepare": "vp run build"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.0-rc.108",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.108",
    "@testcontainers/postgresql": "^11.7.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "effect": "4.0.0-rc.108",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.108 <5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@12.0.0-rc.8"
}
