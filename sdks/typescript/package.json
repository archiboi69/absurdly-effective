{
  "name": "absurd-sdk",
  "version": "0.5.0",
  "description": "TypeScript SDK for Absurd - PostgreSQL-based durable task execution",
  "keywords": [
    "absurd",
    "durable",
    "postgresql",
    "queue",
    "task",
    "workflow"
  ],
  "license": "Apache-2.0",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earendil-works/absurd.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsc --project tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "type-check": "tsc --noEmit",
    "prepare": "vp run build",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.108",
    "@testcontainers/postgresql": "^11.7.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "effect": "4.0.0-rc.108",
    "typedoc": "0.28.20",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.108 <5",
    "pg": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@12.0.0-rc.8"
}
